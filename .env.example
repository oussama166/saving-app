# Copie ce fichier en .env (dev local) et configure les mêmes clés comme
# variables d'environnement sur Vercel pour la prod (Project Settings →
# Environment Variables). Voir DEPLOYMENT.md pour le guide complet.

# --- Base de données -------------------------------------------------------
# En local : laisse vide, l'app utilise automatiquement le fichier
# ./dev.db (voir lib/prisma.ts). En prod : URL + token de ta base Turso
# (turso db show <nom> --url / turso db tokens create <nom>).
TURSO_DATABASE_URL=§
TURSO_AUTH_TOKEN=

# --- Auth --------------------------------------------------------------
# Deux secrets DISTINCTS (jamais la même valeur) — génère chacun avec :
# openssl rand -base64 32
AUTH_SECRET=
ADMIN_AUTH_SECRET=

# --- Email transactionnel (Resend — resend.com, gratuit jusqu'à 3000/mois) --
RESEND_API_KEY=
# Optionnel — nécessite un domaine vérifié sur Resend. Sans ça, les emails
# partent depuis onboarding@resend.dev (fonctionne, mais moins pro).
EMAIL_FROM="WealthOS <onboarding@resend.dev>"

# URL publique du site déployé (utilisée dans les liens des emails). En prod
# sur Vercel : https://ton-projet.vercel.app ou ton domaine personnalisé.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- IA (Coach IA / conseils) — au moins une des deux clés ------------------
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# --- Géocodage (deviner la catégorie d'une transaction par localisation) ---
GEOAPIFY_API_KEY=

# --- Archivage planifié (voir app/api/backup/archive/route.ts) -------------
# Appelé par un cron externe (cron-job.org, GitHub Actions...) — Vercel Hobby
# ne garantit pas de cron interne fiable en continu, d'où ce pattern.
BACKUP_SECRET=invente-un-secret-different-des-autres
BACKUP_ARCHIVE_MONTHS=3

# --- Digest hebdomadaire par email (voir app/api/cron/weekly-digest/route.ts) --
# Même principe que BACKUP_SECRET ci-dessus : cron externe hebdomadaire (ex:
# cron-job.org, tous les lundis 8h) qui POST cette route avec le header
# `x-cron-secret: <valeur>`.
WEEKLY_DIGEST_SECRET=invente-un-autre-secret-different

# --- Export Google Sheets (archivage) --------------------------------------
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
