generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Compte utilisateur — authentification par email/mot de passe (voir
// lib/auth.ts). Toutes les données financières sont désormais scopées par
// userId : chaque compte a ses propres comptes bancaires, catégories,
// transactions, objectifs, etc.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  webhookToken String?  @unique // token dédié pour les webhooks externes (Apple Pay Shortcut, etc.), distinct du cookie de session
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailVerified               Boolean   @default(false)
  verificationToken            String?   @unique
  verificationTokenExpiresAt   DateTime?
  passwordResetToken           String?   @unique
  passwordResetTokenExpiresAt  DateTime?

  // Modération admin (voir app/admin/*) — un compte suspendu ne peut plus se
  // connecter (bloqué à /api/auth/login) et sa session existante est coupée
  // au prochain appel de /api/auth/me (utilisé par TopNav sur chaque page).
  isSuspended      Boolean   @default(false)
  suspendedAt      DateTime?
  suspendedReason  String?

  // Authentification à deux facteurs (TOTP, voir lib/twoFactor.ts) — secret
  // stocké dès la génération du QR code (setup), mais twoFactorEnabled reste
  // false tant que l'utilisateur n'a pas confirmé un code valide (évite
  // qu'un setup abandonné en cours de route verrouille le compte). Les
  // codes de récupération sont stockés hashés (JSON.stringify d'un tableau
  // de hash bcrypt), jamais en clair après leur affichage unique à l'écran.
  twoFactorSecret          String?
  twoFactorEnabled         Boolean   @default(false)
  twoFactorRecoveryCodes   String?

  settings        UserSettings?
  accounts        Account[]
  categories      Category[]
  transactions    Transaction[]
  savingsGoals    SavingsGoal[]
  medicalRecords  MedicalRecord[]
  portfolioAssets PortfolioAsset[]
  aiAdviceCache   AiAdviceCache[]
  subscriptions   Subscription[]
  goalContributions GoalContribution[]
  subscriptionPlanChanges SubscriptionPlanChange[]
  budgetAlertsSent        BudgetAlertSent[]
  debts                   Debt[]
  debtPayments            DebtPayment[]

  // Foyer partagé (voir lib/household.ts) — un utilisateur appartient à au
  // plus un foyer à la fois (@unique sur userId côté HouseholdMember).
  householdMembership   HouseholdMember?
  sentHouseholdInvites  HouseholdInvite[] @relation("HouseholdInvitesSent")

  csvImportProfiles CsvImportProfile[]

  // Exceptions d'accès à des fonctionnalités désactivées globalement (voir
  // lib/features.ts et Feature ci-dessous) — accordées individuellement par
  // un admin.
  featureAccessGrants FeatureAccessGrant[]
}

// Mémorise le mapping de colonnes d'un format de CSV bancaire déjà vu (voir
// lib/csvImport.ts) — la prochaine fois qu'un fichier avec la même
// signature d'en-tête est importé, le mapping est repris automatiquement
// sans redemander à l'utilisateur de faire correspondre les colonnes.
// Rattaché au propriétaire budget (userId), donc partagé par tout le foyer
// — le format d'export d'une banque ne dépend pas de qui importe le fichier.
model CsvImportProfile {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  headerSignature String
  bankLabel       String? // nom donné par l'utilisateur (ex: "CIH Bank"), affichage seulement
  delimiter       String
  hasHeaderRow    Boolean  @default(true)
  dateIdx         Int
  merchantIdx     Int
  amountIdx       Int
  debitIdx        Int
  creditIdx       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, headerSignature])
}

// Interrupteur global par section/fonctionnalité de l'app (voir
// lib/features.ts pour le registre des clés connues et la logique de
// vérification). `key` est stable dans le code (ex: "dashboard",
// "transactions", "coach") — la ligne est créée paresseusement (upsert) au
// premier accès à la page Admin > Fonctionnalités si elle n'existe pas
// encore, donc l'absence de ligne = fonctionnalité active par défaut (voir
// isFeatureEnabledForUser, "fail-open" volontaire pour ne jamais bloquer par
// erreur une fonctionnalité qui n'a pas encore été enregistrée).
model Feature {
  key         String   @id
  name        String // libellé affiché dans l'admin, ex: "Coach IA"
  description String?
  enabled     Boolean  @default(true)
  // Regroupe une sous-fonctionnalité sous sa section parente pour
  // l'affichage admin (ex: "profile.two_factor" a parentKey = "profile") —
  // purement organisationnel, n'affecte PAS la logique de vérification :
  // chaque clé (parente ou enfant) est vérifiée indépendamment via
  // isFeatureEnabledForUser. Désactiver le parent bloque toute la page (voir
  // <FeatureGate>) ; désactiver un enfant ne masque que son bloc précis dans
  // la page (voir <FeatureDisabledInlineCard>).
  parentKey   String?
  // Message affiché à la place du texte générique par défaut quand cette
  // fonctionnalité est désactivée (voir FeatureDisabledNotice /
  // FeatureDisabledInlineCard) — ex: "Cette fonctionnalité revient le 1er
  // août." Optionnel, texte générique utilisé si vide.
  customMessage String?
  updatedAt   DateTime @updatedAt

  accessGrants FeatureAccessGrant[]
}

// Exception d'accès accordée par un admin à un utilisateur précis pour une
// fonctionnalité désactivée globalement (Feature.enabled = false) — voir
// isFeatureEnabledForUser dans lib/features.ts. N'a aucun effet si la
// fonctionnalité est déjà activée globalement (juste redondant dans ce cas).
model FeatureAccessGrant {
  id          String   @id @default(cuid())
  featureKey  String
  feature     Feature  @relation(fields: [featureKey], references: [key])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  grantedAt   DateTime @default(now())

  @@unique([featureKey, userId])
}

model UserSettings {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id])
  referenceIncome           Float    @default(10000)
  currency                  String   @default("MAD")
  emergencyFundTargetMonths Float    @default(3)
  language                  String   @default("fr") // fr, ar, en, es — voir lib/i18n.ts
  // Jour du mois (1-28) où le salaire tombe habituellement — point de départ
  // du "cycle budgétaire" utilisé pour tout ce qui est calculé "depuis le
  // début du mois" (score de santé, budget détaillé, alertes...) à la place
  // du 1er calendaire. 1 = comportement historique (calendaire), inchangé
  // pour tous les comptes existants. Voir lib/budgetCycle.ts : ce jour n'est
  // qu'un repère par défaut — la vraie date du salaire, si détectée parmi les
  // transactions de revenu, prend le dessus (couvre le cas d'une paie
  // parfois un peu plus tôt, parfois un peu plus tard).
  budgetCycleStartDay       Int      @default(1)
  updatedAt                 DateTime @updatedAt
}

model Account {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  name            String
  type            String // checking, savings, investment
  balance         Float            @default(0)
  // Devise du compte — "MAD" pour l'immense majorité des comptes (comptes
  // courants marocains). Un compte en devise étrangère (ex: Wise/Payoneer en
  // USD/EUR pour un revenu freelance) garde son solde ET ses transactions
  // dans CETTE devise ; la conversion en MAD ne se fait qu'à l'affichage/à
  // l'agrégation (dashboard, patrimoine, zakat...), voir lib/exchangeRates.ts.
  currency        String           @default("MAD")
  transactions    Transaction[]
  portfolioAssets PortfolioAsset[]
  subscriptions   Subscription[]
  savingsGoals    SavingsGoal[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Cache des taux de conversion vers MAD (devise de référence de l'app) —
// évite d'interroger l'API externe (open.er-api.com, gratuite, sans clé) à
// chaque requête. Une ligne par devise étrangère réellement utilisée par un
// compte ; rafraîchie si `fetchedAt` a plus de 24h (voir lib/exchangeRates.ts).
model ExchangeRateCache {
  currency  String   @id // "USD", "EUR"... (jamais "MAD" — taux 1 implicite)
  rateToMad Float // 1 unité de `currency` = rateToMad MAD
  fetchedAt DateTime @default(now())
}

model Category {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  name            String
  type            String // income, expense, savings
  order           Int              @default(0)
  budgetPct       Float            @default(0) // % du revenu de référence (page Profil)
  subCategories   SubCategory[]
  transactions    Transaction[]
  categoryArchive CategoryArchive?
  subscriptions   Subscription[]
  savingsGoals    SavingsGoal[]
  budgetAlertsSent BudgetAlertSent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Somme cumulée des transactions archivées (exportées vers Google Sheets puis
// supprimées de la base) pour une catégorie. Permet aux calculs "depuis le
// début" (ex: solde du Fonds d'Urgence) de rester exacts même après un
// nettoyage — on additionne toujours "transactions restantes en base" +
// "archivedTotal" plutôt que de ne compter que ce qui reste physiquement.
// Scopée indirectement via Category.userId, pas besoin de userId direct.
model CategoryArchive {
  id             String    @id @default(cuid())
  categoryId     String    @unique
  category       Category  @relation(fields: [categoryId], references: [id])
  archivedTotal  Float     @default(0)
  lastArchivedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Transaction {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id])
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  subCategory   String?
  paymentMethod String?
  merchant      String
  amount        Float
  date          DateTime       @default(now())
  location      String? // adresse brute envoyée par le webhook Apple Pay (texte, pas géocodée)
  latitude      Float? // coordonnée GPS au moment du paiement, utilisée pour deviner la catégorie (voir lib/placeCategory.ts)
  longitude     Float?
  isRejected    Boolean        @default(false) // true si le webhook a détecté un dépassement du "Safe to Spend" au moment du paiement
  subscriptionId String?       // renseigné si générée automatiquement par un abonnement (voir lib/subscriptions.ts)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  medicalRecord MedicalRecord?
  goalContribution GoalContribution?
  debtPayment   DebtPayment?
}

// Abonnements récurrents mensuels (Netflix, Spotify, PSN Plus, etc.). Chaque
// abonnement génère automatiquement une Transaction dépense le jour de
// prélèvement (billingDay) de chaque mois — voir lib/subscriptions.ts pour la
// logique de rattrapage (pas de cron serveur, hébergement gratuit oblige :
// le rattrapage se déclenche à chaque chargement de la page Abonnements/du
// dashboard). lastChargedYearMonth ("2026-07") évite les doublons.
model Subscription {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  accountId            String
  account              Account       @relation(fields: [accountId], references: [id])
  categoryId           String
  category             Category      @relation(fields: [categoryId], references: [id])
  name                 String // "Netflix"
  provider             String? // clé catalogue (voir lib/subscriptionCatalog.ts), null si abonnement personnalisé
  subCategory          String? // libellé libre ("Streaming Vidéo", "Musique"...), même pattern que Transaction.subCategory
  price                Float
  billingDay           Int // jour du mois (1-31) où le prélèvement a lieu ; si le mois est plus court, on prend le dernier jour
  isActive             Boolean       @default(true)
  lastChargedYearMonth String? // "2026-07" — dernier mois pour lequel une transaction a été générée
  transactions         Transaction[]
  planChanges          SubscriptionPlanChange[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

// Historique des changements de plan/prix détectés automatiquement par
// /api/webhook/subscription-payment (ex: Netflix Standard 45 DH -> Premium
// 95 DH) — voir lib/subscriptionCatalog.ts pour la logique de détection.
// Une entrée par changement réellement appliqué (pas à chaque appel du
// webhook, seulement quand le plan détecté diffère de celui déjà enregistré
// au-delà de la tolérance d'arrondi).
model SubscriptionPlanChange {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  previousName   String
  newName        String
  previousPrice  Float
  newPrice       Float
  changedAt      DateTime     @default(now())
}

// Objectifs d'épargne — personnels ou pour aider un proche (ex: "Frais de
// scolarité de ma sœur"). accountId/categoryId sont nullable côté SQLite
// (colonnes ajoutées via ALTER TABLE sur une table existante — SQLite exige
// un DEFAULT pour une contrainte NOT NULL ajoutée après coup) mais toujours
// fournis par l'API/le formulaire : chaque versement (manuel ou automatique,
// voir lib/goalContributions.ts) crée une vraie Transaction (type savings)
// dans ce compte/cette catégorie, donc visible dans le budget/historique
// comme n'importe quelle autre dépense/épargne.
model SavingsGoal {
  id                        String             @id @default(cuid())
  userId                    String
  user                      User               @relation(fields: [userId], references: [id])
  accountId                 String?
  account                   Account?           @relation(fields: [accountId], references: [id])
  categoryId                String?
  category                  Category?          @relation(fields: [categoryId], references: [id])
  name                      String
  emoji                     String?
  goalType                  String             @default("personnel") // personnel, famille, urgence, projet
  beneficiary               String? // "Ma sœur — Salma"
  note                      String?
  targetAmount              Float
  monthlyContribution       Float              @default(0) // aussi utilisé comme montant du versement auto quand autoContribute=true
  currentAmount             Float              @default(0)
  targetDate                DateTime? // échéance fixe (ex: rentrée scolaire) — sert à calculer le versement mensuel suggéré
  autoContribute            Boolean            @default(false)
  contributionDay           Int                @default(1) // jour du mois (1-31) du versement automatique
  lastContributedYearMonth  String? // "2026-07" — dernier mois pour lequel un versement auto a été généré
  autoAllocatePct           Float              @default(0) // % du salaire auto-alloué à réception (voir app/api/webhook/salary/route.ts)
  contributions             GoalContribution[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
}

// Historique des versements vers un objectif d'épargne — un par contribution
// (manuelle via le formulaire "Ajouter un versement", ou automatique via le
// rattrapage mensuel / l'allocation salaire). transactionId lie le versement
// à la Transaction réelle créée dans le compte (null si pas de compte/
// catégorie configuré sur l'objectif au moment du versement).
model GoalContribution {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  goalId        String
  goal          SavingsGoal  @relation(fields: [goalId], references: [id])
  amount        Float
  date          DateTime     @default(now())
  note          String?
  isAutomatic   Boolean      @default(false)
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  createdAt     DateTime     @default(now())
}

model MedicalRecord {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  transactionId       String?      @unique
  transaction         Transaction? @relation(fields: [transactionId], references: [id])
  provider            String
  amount              Float
  reimbursementStatus String       @default("PENDING") // PENDING, SUBMITTED, REIMBURSED
  date                DateTime
  createdAt            DateTime    @default(now())
}

model PortfolioAsset {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  tickerSymbol    String
  sharesOwned     Float
  averageBuyPrice Float
  assetType       String   @default("Action") // Action, ETF, Crypto, OPCVM, Or
  manualPrice     Float? // utilisé si pas de cotation live disponible
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
}

// Cache des réponses IA (Coach IA, Stratégie & Conseils...) pour limiter la
// consommation de tokens Gemini : une entrée par bloc de conseil (`key`) et
// par utilisateur, régénérée seulement quand elle dépasse le TTL défini côté
// route (ex: 7 jours), pas à chaque chargement de page.
model AiAdviceCache {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  key         String
  content     String // JSON.stringify() de la réponse structurée
  generatedAt DateTime @default(now())

  @@unique([userId, key])
}

// Compte admin — totalement séparé des comptes User (voir lib/adminAuth.ts).
// Pas d'endpoint d'inscription public pour le tout premier admin : créé via
// scripts/create-admin.ts, exécuté localement. Les admins suivants peuvent
// être créés depuis le panel (/admin/admins) par un admin déjà connecté.
// Cookie de session dédié, durée de vie plus courte que la session
// utilisateur normale. isActive remplace la suppression : un admin
// désactivé ne peut plus se connecter (login bloqué) et sa session active
// est coupée au prochain appel de /api/admin/me — jamais supprimé en dur
// pour ne pas casser l'historique d'AdminAuditLog (FK RESTRICT).
model Admin {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AdminAuditLog[]
}

// Journal d'audit des actions admin (suspension/réactivation/suppression
// d'utilisateur, envoi de reset password, création d'un autre admin, etc.)
// — traçabilité minimale mais essentielle pour un panel qui peut suspendre/
// supprimer des comptes. adminEmail est un snapshot au moment de l'action
// (reste lisible même si l'email de l'admin change plus tard).
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  adminEmail String
  action     String // ex: "user.suspend", "user.delete", "admin.create"
  targetType String? // ex: "User", "Admin"
  targetId   String?
  details    String? // JSON.stringify() de détails additionnels (raison, etc.)
  createdAt  DateTime @default(now())
}

// Trace des emails d'alerte budget déjà envoyés (voir lib/budgetAlerts.ts,
// déclenché après chaque nouvelle transaction dépense — POST
// /api/transactions et /api/webhook/apple-pay). Une entrée par (catégorie,
// mois, palier) empêche de renvoyer le même email à chaque transaction
// suivante une fois le palier déjà franchi et notifié.
model BudgetAlertSent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  yearMonth  String // "2026-07"
  threshold  Int // 80 (proche limite) ou 100 (dépassement)
  sentAt     DateTime @default(now())

  @@unique([categoryId, yearMonth, threshold])
}

// Suivi des dettes/prêts (crédit conso, prêt immobilier, dette personnelle
// entre proches...) — utilisé pour calculer le patrimoine net (dashboard,
// calculateur de Zakat) comme actifs (comptes + portfolio) moins
// currentBalance de toutes les dettes actives. Pas de génération
// automatique de transaction mensuelle (contrairement aux abonnements) : le
// remboursement est loggé manuellement via DebtPayment, qui décrémente
// currentBalance et peut optionnellement créer une vraie Transaction dans un
// compte (transactionId), comme GoalContribution pour les objectifs.
model Debt {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  name           String // "Prêt immobilier", "Carte Visa Attijari"
  type           String        @default("autre") // credit, pret_immo, pret_perso, autre
  lender         String? // "Attijariwafa Bank"
  principal      Float // montant initial emprunté
  currentBalance Float // solde restant dû, mis à jour à chaque DebtPayment
  interestRate   Float         @default(0) // taux annuel %, 0 pour une dette perso sans intérêt
  monthlyPayment Float         @default(0) // mensualité indicative, purement informative
  dueDay         Int? // jour du mois de l'échéance (1-31), optionnel
  startDate      DateTime?
  endDate        DateTime? // date de fin prévue, optionnel
  isActive       Boolean       @default(true) // false = soldée/remboursée intégralement
  payments       DebtPayment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// Historique des remboursements d'une dette — un par versement (manuel via
// le formulaire, décrémente Debt.currentBalance). transactionId lie
// optionnellement le versement à une vraie Transaction (compte/catégorie
// "Remboursement de dettes"), null si l'utilisateur logue juste le
// remboursement sans vouloir l'imputer à un compte suivi.
model DebtPayment {
  id            String       @id @default(cuid())
  debtId        String
  debt          Debt         @relation(fields: [debtId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  amount        Float
  date          DateTime     @default(now())
  note          String?
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  createdAt     DateTime     @default(now())
}

// Foyer partagé (couple/famille, max 2 membres) — voir lib/household.ts pour
// toute la logique de résolution. Principe : AUCUNE des tables existantes
// (Account, Transaction, SavingsGoal, Subscription, Debt...) n'est modifiée —
// leurs lignes restent attribuées (userId) à qui les a créées, mais les
// requêtes de lecture s'élargissent à tous les membres du foyer
// (getHouseholdMemberIds). Seules Category/UserSettings (le "budget") sont
// redirigées vers un unique propriétaire canonique (isBudgetOwner) plutôt que
// fusionnées, pour éviter d'avoir deux configurations de budget concurrentes.
model Household {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now())
  members   HouseholdMember[]
  invites   HouseholdInvite[]
}

model HouseholdMember {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  userId        String    @unique // un utilisateur n'appartient qu'à un seul foyer à la fois
  user          User      @relation(fields: [userId], references: [id])
  // true pour celui qui a créé le foyer — PAS un niveau de droits supérieur
  // (les deux membres ont des droits strictement égaux sur tout), seulement
  // le marqueur technique de qui est le "propriétaire budget" canonique dont
  // les Category/UserSettings sont utilisées par le foyer entier.
  isBudgetOwner Boolean   @default(false)
  joinedAt      DateTime  @default(now())
}

// Invitation par email (voir lib/email.ts) avec token à usage unique. Un
// foyer complet (2 membres) ne peut plus émettre de nouvelle invitation tant
// qu'une place ne se libère pas (départ d'un membre).
model HouseholdInvite {
  id              String    @id @default(cuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id])
  invitedByUserId String
  invitedBy       User      @relation("HouseholdInvitesSent", fields: [invitedByUserId], references: [id])
  email           String
  token           String    @unique
  status          String    @default("pending") // pending, accepted, cancelled, expired
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
}
